source_file = module_decl , { use_decl } , { declaration } ;
module_decl = "module" , module_path , terminator ;
module_path = identifier , { "." , identifier } ;
use_decl = "use" , import_path , terminator ;
import_path = module_path , [ "." , import_group ] ;
import_group = "{" , import_item , { "," , import_item } , [ "," ] , "}" ;
import_item = identifier , [ "as" , identifier ] ;
declaration = { annotation } , [ "pub" ] , declaration_core ;
declaration_core = const_decl | function_decl | record_decl | struct_decl | enum_decl | newtype_decl | alias_decl | trait_decl | impl_decl | extern_block ;
annotation = "@" , identifier , [ "(" , argument_list , ")" ] ;
const_decl = "const" , identifier , ":" , type_expr , "=" , expression , terminator ;
function_decl = [ "async" ] , [ "blocking" ] , "fn" , identifier , [ generic_params ] , "(" , [ parameter_list ] , ")" , [ return_type ] , [ where_clause ] , block ;
parameter_list = parameter , { "," , parameter } , [ "," ] ;
parameter = identifier , ":" , type_expr , [ "=" , expression ] ;
return_type = "->" , type_expr ;
generic_params = "<" , generic_param , { "," , generic_param } , [ "," ] , ">" ;
generic_param = identifier , [ ":" , trait_bounds ] ;
trait_bounds = type_expr , { "+" , type_expr } ;
where_clause = "where" , where_item , { "," , where_item } , [ "," ] ;
where_item = type_expr , ":" , trait_bounds ;
record_decl = "record" , identifier , [ generic_params ] , record_body ;
struct_decl = "struct" , identifier , [ generic_params ] , record_body ;
record_body = "{" , { field_decl } , "}" ;
field_decl = [ "pub" ] , identifier , ":" , type_expr , [ "=" , expression ] , terminator ;
enum_decl = "enum" , identifier , [ generic_params ] , "{" , enum_variant , { enum_variant } , "}" ;
enum_variant = identifier , [ "(" , [ type_list ] , ")" | record_body ] , terminator ;
newtype_decl = "newtype" , identifier , [ generic_params ] , "=" , type_expr , terminator ;
alias_decl = "type" , identifier , [ generic_params ] , "=" , type_expr , terminator ;
trait_decl = "trait" , identifier , [ generic_params ] , [ ":" , trait_bounds ] , "{" , { trait_item } , "}" ;
trait_item = function_signature , terminator | function_decl ;
function_signature = [ "async" ] , "fn" , identifier , [ generic_params ] , "(" , [ parameter_list ] , ")" , [ return_type ] , [ where_clause ] ;
impl_decl = "impl" , [ generic_params ] , type_expr , [ "for" , type_expr ] , [ where_clause ] , "{" , { declaration } , "}" ;
extern_block = "extern" , string_literal , "{" , { extern_item } , "}" ;
extern_item = [ "pub" ] , "unsafe" , function_signature , terminator ;
type_expr = borrow_type | pointer_type | function_type | tuple_type | named_type , [ "?" ] ;
borrow_type = "&" , [ "mut" ] , type_expr ;
pointer_type = "*" , ( "const" | "mut" ) , type_expr ;
function_type = "fn" , "(" , [ type_list ] , ")" , "->" , type_expr ;
tuple_type = "(" , type_expr , "," , [ type_list ] , ")" ;
named_type = [ "dyn" ] , module_path , [ "<" , type_list , ">" ] ;
type_list = type_expr , { "," , type_expr } , [ "," ] ;
block = "{" , { statement } , [ expression ] , "}" ;
statement = let_stmt | var_stmt | defer_stmt | ensure_stmt | expression_stmt ;
let_stmt = "let" , pattern , [ ":" , type_expr ] , "=" , expression , terminator ;
var_stmt = "var" , pattern , [ ":" , type_expr ] , "=" , expression , terminator ;
defer_stmt = "defer" , expression , terminator ;
ensure_stmt = "ensure" , expression , "else" , expression , terminator ;
expression_stmt = expression , terminator ;
expression = assignment_expr ;
assignment_expr = logical_expr , [ assignment_operator , assignment_expr ] ;
logical_expr = comparison_expr , { logical_operator , comparison_expr } ;
comparison_expr = additive_expr , { comparison_operator , additive_expr } ;
additive_expr = multiplicative_expr , { additive_operator , multiplicative_expr } ;
multiplicative_expr = unary_expr , { multiplicative_operator , unary_expr } ;
unary_expr = { unary_operator } , postfix_expr ;
postfix_expr = primary_expr , { call_suffix | member_suffix | index_suffix | await_suffix | try_suffix } ;
primary_expr = literal | identifier | tuple_expr | array_expr | block | if_expr | match_expr | loop_expr | closure_expr | task_group_expr | unsafe_expr ;
pattern = identifier | "_" | literal | tuple_pattern | variant_pattern ;
terminator = ";" | newline ;
literal = integer_literal | float_literal | string_literal | char_literal | "true" | "false" | "none" ;
