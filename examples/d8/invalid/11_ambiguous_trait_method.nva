module examples.d8.invalid.ambiguous_trait_method

trait LeftShow {
    fn show(self: &Self) -> String
}

trait RightShow {
    fn show(self: &Self) -> String
}

record User { name: String }

impl LeftShow for User {
    fn show(self: &Self) -> String { self.name }
}

impl RightShow for User {
    fn show(self: &Self) -> String { self.name }
}

fn main() {
    let user = User { name: "Nivra" }
    let text = user.show()
}
